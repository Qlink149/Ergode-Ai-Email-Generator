# Copy this file to .env and fill in real values. .env is never committed.

# Required to generate AI drafts and run the comparison pipeline.
OPENAI_API_KEY=

# Which OpenAI model to use for drafting replies.
OPENAI_MODEL=gpt-4o-mini

# Port the report-viewing API server runs on.
SERVER_PORT=4000

# Port the Python FastAPI pipeline service runs on.
PIPELINE_PORT=8001

# How the Express server reaches the Python pipeline service. Locally
# they're two processes on two ports. In production, server and pipeline
# deploy together as ONE Vercel project (root vercel.json) - Express at
# the domain root, FastAPI under /pyapi - so PIPELINE_URL there should be
# https://<that-project's-domain>/pyapi, same domain, no separate deploy.
PIPELINE_URL=http://localhost:8001

# How the Python pipeline reaches the Express server (order-lookup reuse).
# Locally a separate port; in production, the same domain as PIPELINE_URL
# above with no path suffix, e.g. https://<that-project's-domain>.
SERVER_URL=http://localhost:4000

# How the React client (its own separate Vercel project) reaches the
# server+pipeline project above. Leave unset locally - Vite's dev proxy
# (vite.config.js) handles it instead. In production, that project's
# deployed domain, e.g. https://ergode-ai-email-generator-wh98.vercel.app.
VITE_API_URL=

# Comma-separated allowlist of origins the backend accepts requests from.
# Unset locally = wide open (fine for local dev). In production, set to
# the frontend's domain(s), e.g.:
# CORS_ORIGIN=https://ergode.claraai.tech,https://ergode-ai-email-generator.vercel.app
CORS_ORIGIN=

# Order Details API (see clara-ai-external-order-api-guide.pdf for credentials).
ORDER_API_URL=https://media.ergodeapps.com/API/external_order_api_controller.php
ORDER_API_USERNAME=
ORDER_API_PASSWORD=

# CRM Thread-Context API (shared secret header, see CRM_Thread_Context_API.pdf).
CRM_API_URL=https://ai.ergodeapps.com/amiventure-api/crm/thread-context
CRM_API_KEY=

# MongoDB (shared by both the Node server and the Python pipeline).
# The Atlas cluster is in AWS Mumbai (ap-south-1) - keep the Vercel
# functions in the same region (vercel.json's "regions": ["bom1"]) so the
# server<->DB round trips that happen on every request aren't crossing
# continents. Recommended query options on the URI:
#   ...mongodb.net/?retryWrites=true&w=majority&appName=ergode
MONGODB_URI=
MONGODB_DB_NAME=ergode

# Login gate for the whole app - a single shared password, not per-user
# accounts. AUTH_TOKEN_SECRET is a separate server-only value used to
# derive the session token - generate any long random string for it.
APP_LOGIN_PASSWORD=
AUTH_TOKEN_SECRET=
